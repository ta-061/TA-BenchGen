      "defect": "D1",
      "new": "\tcase TEE_FALSE:\n\t\tif (throttle && timeout > 0) {\n\t\t\terror = ERROR_RETRY;\n\t\t} else if (password_handle->version > HANDLE_VERSION) {\n\t\t\terror = ERROR_UNKNOWN;\n\t\t\tres = TEE_ERROR_BAD_PARAMETERS;\n\t\t} else {\n\t\t\terror = ERROR_INVALID;\n\t\t}\n\t\tgoto serialize_response;\n",
      "old": "\tcase TEE_FALSE:\n\t\tif (throttle && timeout > 0) {\n\t\t\terror = ERROR_RETRY;\n\t\t} else {\n\t\t\terror = ERROR_INVALID;\n\t\t}\n\t\tgoto serialize_response;\n",
      "path": "ta/gatekeeper_ta.c"
    },
    {
      "defect": "D2",
      "new": "\tcase ERROR_INVALID:\n\t\tserialize_blob(&i_resp, provided_password, provided_password_length > 32 ? 32 : provided_password_length);\n\t\tbreak;\n\tcase ERROR_UNKNOWN:\n\t\tbreak;\n\tcase ERROR_RETRY:\n\t\tserialize_int(&i_resp, timeout);\n\t\tbreak;\n\tcase ERROR_NONE:\n\t\tserialize_blob(&i_resp, (uint8_t *)&auth_token, sizeof(auth_token));\n",
      "old": "\tcase ERROR_INVALID:\n\tcase ERROR_UNKNOWN:\n\t\tbreak;\n\tcase ERROR_RETRY:\n\t\tserialize_int(&i_resp, timeout);\n\t\tbreak;\n\tcase ERROR_NONE:\n\t\tserialize_blob(&i_resp, (uint8_t *)&auth_token, sizeof(auth_token));\n",
      "path": "ta/gatekeeper_ta.c"
