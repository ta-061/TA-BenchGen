      "id": "D1",
      "reason": "In Verify, the password handle is used directly from the caller-writable request buffer instead of a private copy. After the early version check, the failure path reads the version from that buffer a second time. If the buffer changes in between, the reported error code and the result differ from the normal behavior.",
      "witness_test_ids": [
        "T02"
      ]
    },
    {
      "class": "UDO",
      "detector_targets": [
        {
          "function": "TA_Verify",
          "lines": [
            700,
            700
          ],
          "path": "ta/gatekeeper_ta.c",
          "role": "effect"
        }
      ],
      "id": "D2",
      "reason": "When verification fails, the Verify response now includes the plaintext password supplied by the caller. A value the TA must protect is written to the output without protection.",
      "witness_test_ids": [
        "T03"
      ]
    }
  ],
