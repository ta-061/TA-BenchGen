            224
          ],
          "path": "ta/gatekeeper_ta.c",
          "role": "protection"
        }
      ],
      "id": "D2",
      "reason": "For passwords longer than 8 bytes, the first bytes of the plaintext password are copied into the flags field of the password handle after signing. The handle is returned to the caller, so the protected password appears in the output unprotected.",
      "witness_test_ids": [
        "T03"
      ]
    }
  ],
