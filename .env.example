# 読み込みはシェルの export を使用。自動で .env は読みません。
# モデルの登録と選択は config/models.yaml で行います。
TA_BENCH_IMAGE=
# 使用する登録名を一時的に切り替える場合（config/models.yaml の use より優先）
TA_BENCH_USE=
# APIキー。config/api_keys.local.yaml に書くこともできます。
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# ワークスペース未指定のAPIキーで必要な場合のみ設定します。
ANTHROPIC_WORKSPACE_ID=
# 登録の model / api_url が空欄のときだけ使われます。
TA_BENCH_MODEL=
TA_BENCH_API_URL=
